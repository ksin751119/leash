# --- Secrets: must never enter a public repo ---
.env
.env.*
!.env.example
*.key
*.pem
run_scripts/

# --- Foundry ---
out/
cache/
broadcast/
!broadcast/*/*/run-latest.json

# --- Node / subgraph / frontend ---
node_modules/
generated/
build/
dist/
.next/
.pnpm-store/

# --- Isolated workspaces (git worktree) ---
# Without this, an entire worktree gets committed into the repo
.worktrees/
.superpowers/

# --- Misc ---
.DS_Store
*.log

# --- matchstick build artifacts ---
subgraph/tests/.bin/
subgraph/tests/.latest.json
