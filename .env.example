# Copy to .env and fill in. .env is gitignored - never commit it.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# --- Three keys, deliberately separated (rationale: the key model in docs/architecture.md) ---
# ADMIN: holds leash.eth and its ENS EAC roles. Changes rules, revokes agents. Holds no operating funds.
ADMIN_ADDR=
ADMIN_PK=
# WALLET: the one with the money. Deliberately has no ENS authority at all - a broken policy
#         can at most drain the funds; it cannot reach the control plane.
WALLET_ADDR=
WALLET_PK=
# AGENT: a session key. Holds nothing; it is only a msg.sender the policy recognises.
AGENT_ADDR=
AGENT_PK=

# --- ENSv2 Sepolia (addresses in docs/ensv2-sepolia.md) ---
ETH_REGISTRAR=0xa88553f454b77203b0d036a05c894d555eaaa2cc
ETH_REGISTRY=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ROOT_REGISTRY=0x8115186e8f2e0b0281e86ab91f0f48ba90364354
UNIVERSAL_RESOLVER=0x4a1817d13e9cf196f471725176355c1234b63c70
MOCK_USDC=0x768f42455a2d082e23ceef7d51e5787c82d67a39

# --- World ---
WORLD_APP_ID=
WORLD_RP_ID=
# ⚠️ This is the **v4 RP's signer private key**, not an API key.
#    Confirmed 2026-09-08: the address it derives to is exactly the signer address shown in
#    the Developer Portal. It used to be called WORLD_API_KEY, a name that invites putting
#    it in a frontend - leaking it lets anyone sign rp_context as your app. Renamed to
#    prevent that mistake.
WORLD_RP_SIGNER_PK=

# --- The Graph ---
GRAPH_DEPLOY_KEY=
