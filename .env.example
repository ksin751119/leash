# 複製成 .env 後填入。.env 已被 gitignore,永遠不要 commit。
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# --- 三把鑰匙,刻意分開(理由見 docs/PLAN.md「金鑰模型」)---
# ADMIN:持有 leash.eth 與 ENS EAC 角色。改規則、撤銷 agent。不裝營運資金。
ADMIN_ADDR=
ADMIN_PK=
# WALLET:裝錢的那個。刻意沒有任何 ENS 權限 —— 壞掉的 policy 最多花光錢,動不了控制權。
WALLET_ADDR=
WALLET_PK=
# AGENT:session key,什麼都不持有,只是個被 policy 認得的 msg.sender。
AGENT_ADDR=
AGENT_PK=

# --- ENSv2 Sepolia(位址見 docs/ensv2-sepolia.md)---
ETH_REGISTRAR=0xa88553f454b77203b0d036a05c894d555eaaa2cc
ETH_REGISTRY=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ROOT_REGISTRY=0x8115186e8f2e0b0281e86ab91f0f48ba90364354
UNIVERSAL_RESOLVER=0x4a1817d13e9cf196f471725176355c1234b63c70
MOCK_USDC=0x768f42455a2d082e23ceef7d51e5787c82d67a39

# --- World ---
WORLD_APP_ID=
WORLD_RP_ID=
# ⚠️ 這是 **v4 RP 的 signer 私鑰**,不是 API key。
#    2026-09-08 查證:它推導出的位址就是 Developer Portal 上顯示的 signer address。
#    原本叫 WORLD_API_KEY,那個名字會讓人以為可以放前端 —— 外洩等於別人能冒充你的 app
#    簽 rp_context。改名以免誤用。
WORLD_RP_SIGNER_PK=

# --- The Graph ---
GRAPH_DEPLOY_KEY=
